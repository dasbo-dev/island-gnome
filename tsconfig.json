{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@girs/gnome-shell/ambient", "@girs/gnome-shell/extensions/global"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
